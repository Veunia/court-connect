{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://glgkkhxorgbmctwyzopf.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "basket-crew",
      "version": "0.1.0",
      "title": "Basket Crew"
    },
    "tools": [
      {
        "name": "list_spaces",
        "title": "List my clubs",
        "description": "List the Basket Crew clubs (spaces) the signed-in user belongs to, with their role in each.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_sessions",
        "title": "List basketball sessions",
        "description": "List upcoming basketball sessions for a club, with date, time, location, court type, capacity and current signup count. Use list_spaces first to get a club id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "space_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Club (space) id from list_spaces."
            },
            "include_past": {
              "description": "Include sessions whose date has already passed.",
              "type": "boolean"
            }
          },
          "required": [
            "space_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_session_players",
        "title": "Get session players",
        "description": "List the players signed up for a session and those on its waiting list, with their preferred position.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Session id from list_sessions."
            }
          },
          "required": [
            "session_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_session",
        "title": "Create a session",
        "description": "Create a basketball session in one of the signed-in user's clubs. The user becomes the organizer. Times are local HH:MM, date is YYYY-MM-DD.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "space_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Club (space) id from list_spaces."
            },
            "title": {
              "description": "Session title, e.g. 'Session du mardi'.",
              "type": "string"
            },
            "session_date": {
              "type": "string",
              "description": "Date as YYYY-MM-DD."
            },
            "start_time": {
              "type": "string",
              "description": "Start time as HH:MM."
            },
            "end_time": {
              "type": "string",
              "description": "End time as HH:MM."
            },
            "location": {
              "type": "string",
              "description": "Gym, playground or address."
            },
            "category": {
              "type": "string",
              "enum": [
                "interieur",
                "exterieur",
                "tournoi"
              ],
              "description": "Session category."
            },
            "court": {
              "type": "string",
              "enum": [
                "demi",
                "plein"
              ],
              "description": "Half court or full court."
            },
            "max_players": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Maximum number of players (2-30)."
            },
            "whatsapp_url": {
              "description": "Optional WhatsApp group link.",
              "type": "string"
            }
          },
          "required": [
            "space_id",
            "session_date",
            "start_time",
            "end_time",
            "location",
            "category",
            "court",
            "max_players"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "set_my_signup",
        "title": "Join or leave a session",
        "description": "Sign the current user up for a session, put them on its waiting list, or remove them from both. Never affects other players.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Session id from list_sessions."
            },
            "action": {
              "type": "string",
              "enum": [
                "join",
                "leave",
                "waitlist"
              ],
              "description": "join = sign up, waitlist = queue, leave = withdraw."
            }
          },
          "required": [
            "session_id",
            "action"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_my_profile",
        "title": "Get my player profile",
        "description": "Read the signed-in user's Basket Crew player profile: name, preferred position and match counters.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
